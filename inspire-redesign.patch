index 0000000..233ce42
--- /dev/null
+++ b/src/components/ui/reveal.tsx
@@ -0,0 +1,27 @@
+import { motion, useReducedMotion } from "framer-motion";
+import type { ReactNode } from "react";
+
+/** Subtle fade-up on scroll. Disabled when the device asks for reduced motion. */
+export function Reveal({
+  children,
+  delay = 0,
+  className,
+}: {
+  children: ReactNode;
+  delay?: number;
+  className?: string;
+}) {
+  const reduce = useReducedMotion();
+  if (reduce) return <div className={className}>{children}</div>;
+  return (
+    <motion.div
+      className={className}
+      initial={{ opacity: 0, y: 12 }}
+      whileInView={{ opacity: 1, y: 0 }}
+      viewport={{ once: true, amount: 0.15 }}
+      transition={{ duration: 0.4, delay, ease: "easeOut" }}
+    >
+      {children}
+    </motion.div>
+  );
+}
diff --git a/src/components/ui/section-header.tsx b/src/components/ui/section-header.tsx
